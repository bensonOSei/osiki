# MongoDB
MONGODB_URL=mongodb://mongodb:27017/osiki
MONGODB_DATABASE=osiki
# Team operations run in MongoDB transactions, which need a replica set (the
# dev docker-compose mongodb is one). Set false for standalone MongoDB.
# Running the API outside Docker against the compose mongodb? Use
# MONGODB_URL=mongodb://localhost:27017/osiki?directConnection=true
MONGODB_TRANSACTIONS=true

# Redis
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
